---
import Layout from "../layouts/Layout.astro";
import TerminalWindow from "../components/TerminalWindow.astro";
import MobileNotice from "../components/MobileNotice.astro";
import { PORTFOLIO_DATA } from "../data/portfolio";
---

<Layout
  title={`404 NOT FOUND // ${PORTFOLIO_DATA.developer.name} TUI`}
  description="404 Error: The requested virtual terminal address was not found."
>
  <TerminalWindow>
    <!-- Mobile Notice Banner -->
    <MobileNotice />

    <div class="space-y-6 text-xs sm:text-sm font-mono py-2 select-text">
      <!-- Top Alert Bar -->
      <div
        class="flex flex-wrap items-center justify-between gap-2 p-3 bg-red-950/40 border border-red-500/50 rounded-none text-red-400 animate-pulse"
      >
        <div class="flex items-center gap-2">
          <span class="text-base font-bold">⚠️ [SYSTEM ERROR 404]</span>
          <span class="hidden sm:inline"
            >KERNEL PANIC: REQUESTED ROUTE UNMAPPED</span
          >
        </div>
        <div
          class="px-2 py-0.5 bg-red-900/60 border border-red-500/60 text-red-200 text-[11px] font-bold"
        >
          STATUS: 404 NOT FOUND
        </div>
      </div>

      <!-- ASCII 404 Header -->
      <div class="overflow-x-auto text-[var(--accent)] font-bold leading-tight py-2">
        <pre class="font-mono text-[9px] sm:text-xs md:text-sm select-none">
██╗  ██╗ ██████╗  ██╗  ██╗    ███╗   ██╗ ██████╗ ████████╗    ███████╗██████╗ ██████╗  ██████╗ ██████╗ 
██║  ██║██╔═══██╗ ██║  ██║    ████╗  ██║██╔═══██╗╚══██╔══╝    ██╔════╝██╔══██╗██╔══██╗██╔═══██╗██╔══██╗
███████║██║   ██║ ███████║    ██╔██╗ ██║██║   ██║   ██║       █████╗  ██████╔╝██████╔╝██║   ██║██████╔╝
╚════██║██║   ██║ ╚════██║    ██║╚██╗██║██║   ██║   ██║       ██╔══╝  ██╔══██╗██╔══██╗██║   ██║██╔══██╗
     ██║╚██████╔╝      ██║    ██║ ╚████║╚██████╔╝   ██║       ███████╗██║  ██║██║  ██║╚██████╔╝██║  ██║
     ╚═╝ ╚═════╝       ╚═╝    ╚═╝  ╚═══╝ ╚═════╝    ╚═╝       ╚══════╝╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚═╝
        </pre>
      </div>

      <!-- System Diagnostic Terminal Log -->
      <div
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 space-y-2 text-[var(--fg-main)]"
      >
        <div class="text-[var(--fg-bright)] font-bold flex items-center gap-2 border-b border-[var(--border-color)] pb-2">
          <span class="text-[var(--accent)]">⚡ DIAGNOSTIC LOG:</span>
          <span>SYSTEM_PANIC_TRACE_0x0404.LOG</span>
        </div>

        <div class="space-y-1.5 text-xs text-[var(--fg-dim)]">
          <p>
            <span class="text-[var(--accent)]">[0.000104]</span> INITIALIZING VIRTUAL FILESYSTEM AUDIT...
          </p>
          <p>
            <span class="text-[var(--accent)]">[0.000312]</span> TARGET ROUTE:
            <span id="requested-url-path" class="text-red-400 font-bold bg-red-950/50 px-1 py-0.5 border border-red-800/50">
              loading...
            </span>
          </p>
          <p>
            <span class="text-[var(--accent)]">[0.000589]</span> MEMORY POINTER RESOLVED TO 0x00000000 (NULL)
          </p>

          <div class="p-2.5 bg-[var(--bg-main)] border border-[var(--border-color)] font-mono text-xs my-2 space-y-1 text-[var(--fg-main)]">
            <p class="text-red-400 font-bold">> ERROR_CAUSE: Sector memory unallocated or document relocated.</p>
            <p class="text-[var(--fg-dim)]">> SUGGESTED_ACTION: Return to root directory <span class="text-[var(--accent)] font-bold">~/portfolio</span> or issue CLI command below.</p>
          </div>
        </div>
      </div>

      <!-- Interactive 404 Quick Actions -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
        <a
          href="/"
          id="btn-return-home"
          class="flex items-center justify-center gap-2 p-3 bg-[var(--border-color)] hover:bg-[var(--border-active)] border border-[var(--accent)] text-[var(--fg-bright)] font-bold transition-all group cursor-pointer text-center"
        >
          <span class="text-[var(--accent)] group-hover:translate-x-[-2px] transition-transform">🚀</span>
          <span>RETURN HOME [ / ]</span>
        </a>

        <button
          id="btn-404-matrix"
          class="flex items-center justify-center gap-2 p-3 bg-[var(--bg-card)] hover:bg-[var(--border-color)] border border-[var(--border-color)] hover:border-[var(--accent)] text-[var(--fg-bright)] font-bold transition-all cursor-pointer text-center"
        >
          <span class="text-[var(--accent)]">⚡</span>
          <span>TRIGGER MATRIX</span>
        </button>

        <button
          id="btn-404-reboot"
          class="flex items-center justify-center gap-2 p-3 bg-[var(--bg-card)] hover:bg-[var(--border-color)] border border-[var(--border-color)] hover:border-red-500/80 text-[var(--fg-bright)] font-bold transition-all cursor-pointer text-center"
        >
          <span class="text-red-400">🔄</span>
          <span>SYSTEM REBOOT</span>
        </button>
      </div>

      <!-- 404 Interactive CLI Prompt -->
      <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 space-y-3">
        <div class="flex items-center justify-between text-xs text-[var(--fg-dim)] border-b border-[var(--border-color)] pb-2">
          <span class="font-bold text-[var(--fg-bright)]">📟 EMERGENCE RECOVERY CONSOLE</span>
          <span>TYPE 'help' FOR COMMANDS</span>
        </div>

        <div id="console-output" class="space-y-1 font-mono text-xs max-h-40 overflow-y-auto">
          <p class="text-[var(--fg-dim)]">Emergency terminal initialized. Type <span class="text-[var(--accent)] font-bold">home</span> to return to portfolio.</p>
        </div>

        <form id="console-form" class="flex items-center gap-2 pt-1">
          <span class="text-[var(--accent)] font-bold select-none">&gt;</span>
          <input
            type="text"
            id="console-input"
            autocomplete="off"
            spellcheck="false"
            placeholder="Type 'home', 'matrix', 'clear', or 'help'..."
            class="w-full bg-transparent text-[var(--fg-bright)] focus:outline-none font-mono text-xs sm:text-sm placeholder-[var(--fg-dim)]/50"
          />
        </form>
      </div>
    </div>
  </TerminalWindow>
</Layout>

<script>
  import { playBeep, playErrorSound, playSuccessSound, playKeypressSound } from "../utils/sound";

  document.addEventListener("DOMContentLoaded", () => {
    // 1. Play 404 Error Audio Feedback on Load
    setTimeout(() => {
      playErrorSound();
    }, 200);

    // 2. Display actual requested path
    const requestedPathEl = document.getElementById("requested-url-path");
    if (requestedPathEl) {
      requestedPathEl.textContent = window.location.pathname || "/unknown-route";
    }

    // 3. Update current path in header if available
    const headerPathEl = document.getElementById("current-path");
    if (headerPathEl) {
      headerPathEl.textContent = "~/404-error";
    }

    // 4. Quick Action Button Event Handlers
    const btnHome = document.getElementById("btn-return-home");
    btnHome?.addEventListener("click", () => {
      playSuccessSound();
    });

    const btnMatrix = document.getElementById("btn-404-matrix");
    btnMatrix?.addEventListener("click", () => {
      const win = window as unknown as { toggleMatrix?: (f?: boolean) => void };
      if (win.toggleMatrix) {
        win.toggleMatrix();
        playBeep(700, 0.08);
        const matrixContainer = document.getElementById("matrix-container");
        const isActive = matrixContainer && !matrixContainer.classList.contains("hidden");
        appendConsoleLog(
          isActive ? "⚡ Matrix rain activated." : "⚡ Matrix rain deactivated.",
          isActive ? "text-[var(--accent)] font-bold" : "text-[var(--fg-dim)]"
        );
      }
    });

    const btnReboot = document.getElementById("btn-404-reboot");
    btnReboot?.addEventListener("click", () => {
      playErrorSound();
      appendConsoleLog("🔄 Rebooting virtual system... Redirecting home.", "text-yellow-400 font-bold");
      setTimeout(() => {
        window.location.href = "/";
      }, 1000);
    });

    // 5. Interactive Console Logic
    const consoleOutput = document.getElementById("console-output");
    const consoleForm = document.getElementById("console-form") as HTMLFormElement;
    const consoleInput = document.getElementById("console-input") as HTMLInputElement;

    function appendConsoleLog(text: string, className = "text-[var(--fg-main)]") {
      if (!consoleOutput) return;
      const p = document.createElement("p");
      p.className = `font-mono text-xs ${className}`;
      p.innerHTML = text;
      consoleOutput.appendChild(p);
      consoleOutput.scrollTop = consoleOutput.scrollHeight;
    }

    consoleInput?.addEventListener("keydown", () => {
      playKeypressSound();
    });

    consoleForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const rawCmd = consoleInput.value.trim();
      if (!rawCmd) return;

      appendConsoleLog(`&gt; ${rawCmd}`, "text-[var(--fg-bright)] font-bold");
      consoleInput.value = "";

      const cmd = rawCmd.toLowerCase();

      switch (cmd) {
        case "help":
          playBeep(600, 0.04);
          appendConsoleLog("Available commands:", "text-[var(--accent)] font-bold");
          appendConsoleLog("  <span class='text-[var(--fg-bright)] font-bold'>home / cd / exit</span>  - Return to home portfolio");
          appendConsoleLog("  <span class='text-[var(--fg-bright)] font-bold'>matrix</span>           - Toggle matrix digital rain");
          appendConsoleLog("  <span class='text-[var(--fg-bright)] font-bold'>reboot / panic</span>   - Trigger system reboot sequence");
          appendConsoleLog("  <span class='text-[var(--fg-bright)] font-bold'>clear / cls</span>      - Clear console screen output");
          break;

        case "home":
        case "cd":
        case "exit":
        case "cd ~":
        case "cd /":
          playSuccessSound();
          appendConsoleLog("🚀 Redirecting to root filesystem ~/portfolio...", "text-emerald-400 font-bold");
          setTimeout(() => {
            window.location.href = "/";
          }, 600);
          break;

        case "matrix":
          const win = window as unknown as { toggleMatrix?: (f?: boolean) => void };
          if (win.toggleMatrix) {
            win.toggleMatrix();
            playBeep(700, 0.08);
            const matrixContainer = document.getElementById("matrix-container");
            const isActive = matrixContainer && !matrixContainer.classList.contains("hidden");
            appendConsoleLog(
              isActive ? "⚡ Matrix rain activated." : "⚡ Matrix rain deactivated.",
              isActive ? "text-[var(--accent)] font-bold" : "text-[var(--fg-dim)]"
            );
          }
          break;

        case "reboot":
        case "panic":
          playErrorSound();
          appendConsoleLog("💥 KERNEL RESET TRIGGERED...", "text-red-400 font-bold");
          setTimeout(() => {
            window.location.href = "/";
          }, 800);
          break;

        case "clear":
        case "cls":
          playBeep(450, 0.04);
          if (consoleOutput) {
            consoleOutput.innerHTML = "";
          }
          break;

        default:
          playErrorSound();
          appendConsoleLog(
            `bash: command not found: <span class='text-red-400 font-bold'>${rawCmd}</span>. Type '<span class='text-[var(--accent)] font-bold'>home</span>' or '<span class='text-[var(--accent)] font-bold'>help</span>'.`,
            "text-red-300"
          );
          break;
      }
    });
  });
</script>
